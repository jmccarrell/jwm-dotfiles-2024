#!/usr/bin/env bash
# set my path exactly how I want it.

# declare jeffs home paths
function jwm_home_paths() {
    local -a jwm_paths=("$HOME/bin"
                        "$HOME/.local/bin")

    printf "%s\n" "${jwm_paths[@]}"
}

# the path where the determinate nix installer puts nix on my macos box
function nix_path() {
    local -a nix_paths=(/nix/var/nix/profiles/default/bin)

    printf "%s\n" "${nix_paths[@]}"
}

# define GOPATH, and set PATH from GOPATH as needed.
function jwm_go_locations() {
    declare -a go_locations=( "${HOME}/go" )

    printf "%s\n" "${go_locations[@]}"
}

# return every go project as a list of of lines
function jwm_go_paths() {
    declare -a go_paths=()
    declare -a go_locations=( "$(jwm_go_locations)" )
    if (( ${#go_locations[@]} > 0 )); then
        for gp in "${go_locations[@]}"; do
            if [[ -e "$gp" && -e "${gp}/bin" ]]; then
                go_paths+=( "$gp" )
            fi
        done
    fi
    printf "%s\n" "${go_paths[@]}"
}

# return the bin directory for every go project as a list of lines
function jwm_go_bin_paths() {
    declare -a go_locs=( "$(jwm_go_locations)" )
    declare -a go_bin_paths=()
    for gl in "${go_locs[@]}"; do
        if [[ -e $gl && -e $gl/bin ]]; then
            go_bin_paths+=( "$gl/bin" )
        fi
    done

    printf "%s\n" "${go_bin_paths[@]}"
}

function jwm_standard_paths() {
    paths_fname=/etc/paths
    local -a standard_paths=()
    if [[ -f ${paths_fname} && -r ${paths_fname} ]]; then
        # mapfile rather than `/bin/cat < $paths_fname`: same output, one fewer
        # fork per login shell. /etc/paths is six short lines; bash reads it
        # directly without help.
        mapfile -t standard_paths < "$paths_fname"
    else
        standard_paths=("/usr/local/bin" "/usr/bin" "/bin")
    fi
    (( ${#standard_paths[@]} )) && printf "%s\n" "${standard_paths[@]}"
}

function jwm_opt_homebrew_path() {
    printf "%s\n" /opt/homebrew/bin
}

function jwm_brew_cmd() {
    local brew_cmd=''
    local candidate=''

    for candidate in /opt/workbrew/bin/brew "$(command -v brew 2>/dev/null)" /opt/homebrew/bin/brew /usr/local/bin/brew; do
        if [[ -n "$candidate" && -x "$candidate" ]]; then
            brew_cmd="$candidate"
            break
        fi
    done

    if [[ -n "$brew_cmd" ]]; then
        printf "%s\n" "$brew_cmd"
        return 0
    fi

    return 1
}

function jwm_gcloud_sdk_path() {
    # gcloud_sdk_bin='/usr/local/Caskroom/google-cloud-sdk/latest/google-cloud-sdk/bin'
    gcloud_sdk_bin="${HOME}/google-cloud-sdk/bin"
    if [[ -e "$gcloud_sdk_bin" ]]; then
        printf "%s\n" "$gcloud_sdk_bin"
        return
    fi
    printf '\n'
}

# add the mise shims dir, in the slot asdf_shims() used to hold.
#
# Interactive shells get `mise activate` instead, cached via jwm_shell_init in
# ~/.bash_profile. Activation prepends the real install dirs and wins over these
# shims -- verified rather than assumed: with both in play `mise doctor` reports
# activated: yes and shims_on_path: yes without complaint, and `command -v
# terraform` resolves to ~/.local/share/mise/installs/... not to a shim.
#
# So these shims are for everything that never sources ~/.bash_profile: the
# `daily` launchd job, GUI apps, anything spawned outside a login shell. That is
# coverage asdf's shims gave for free, and dropping it would have regressed
# silently rather than visibly.
#
# Keeping the slot also keeps this ahead of /opt/homebrew/bin, which matters on
# the other mac: brew node is installed there and cannot be removed (gemini-cli
# depends on it), so PATH order is the only thing stopping brew's node from
# shadowing the mise-managed one.
function mise_shims() {
    local mise_shims="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/shims"
    if [[ -e "${mise_shims}" ]]; then
        printf "%s\n" "$mise_shims"
        return
    fi
    printf '\n'
}

function mark43_paths() {
    declare -a mark43_paths=( "$HOME/mark43/bin"
                              "$HOME/code/mark43/dev-tools/vault" )
    printf "%s\n" "${mark43_paths[@]}"
}

# rust/cargo. ~/.bash_profile also sources ~/.cargo/env, but it does so only for
# interactive shells -- so without this, a non-interactive consumer that sources
# just .functions and .path (the `daily` launchd job) never sees rustup.
function jwm_cargo_path() {
    cargo_bin="${HOME}/.cargo/bin"
    if [[ -e "${cargo_bin}" ]]; then
        printf "%s\n" "$cargo_bin"
        return
    fi
    printf '\n'
}

function jwm_set_path() {
    # create a standard simple path
    local -a std_paths=()
    while IFS= read -r dir; do
        if [[ -e ${dir} ]] && [[ -r ${dir} ]]; then
            std_paths+=( "$dir" )
        fi
    done < <( jwm_standard_paths; jwm_opt_homebrew_path )

    PATH=$(join_by : "${std_paths[@]}")

    # then let brew, etc. do their thing
    #
    # `brew shellenv` costs 17.0ms, of which only 2.3ms is the nested
    # `path_helper -s` it eval's -- so caching its *script text* (which keeps
    # that inner call, and therefore still reacts to the current PATH) saves the
    # ~14.7ms brew itself takes. jwm_shell_init falls back to the live command,
    # so a cold or unwritable cache behaves exactly as this line used to.
    #
    # jwm_brew_cmd stays the source of truth for *which* brew: the cached script
    # is regenerated through it, and it is machine-local, so the Workbrew prefix
    # on the Mark43 mac and the Homebrew one elsewhere never cross.
    local brew_cmd=''
    brew_cmd=$(jwm_brew_cmd 2>/dev/null)
    if [[ -n "$brew_cmd" ]]; then jwm_shell_init brewenv; fi

    # then prepend my preferred paths
    # first, remove any duplicate path elements
    local -A dedup
    local -a jwm_paths=()

    for dir in \
        $(nix_path) \
        $(mise_shims) \
        $(jwm_home_paths) \
        $(mark43_paths) \
        $(jwm_go_bin_paths) \
        $(jwm_gcloud_sdk_path) \
        $(jwm_cargo_path) \
        ; do
        if [[ ${dedup[$dir]+_} ]]; then
            continue
        fi
        dedup[${dir}]=1

        if [[ -e $dir ]]; then
            jwm_paths+=( "$dir" )
        fi
    done

    PATH=$(join_by : "$(join_by : "${jwm_paths[@]}")" "${PATH}")
}
