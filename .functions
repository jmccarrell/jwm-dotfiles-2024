#!/usr/bin/env bash

# Create a new directory and enter it
function mkd() {
    mkdir -p "$@" && cd "$_" || exit 23;
}

# Determine size of a file or total size of a directory
function fs() {
    if du -b /dev/null > /dev/null 2>&1; then
        local arg=-sbh;
    else
        local arg=-sh;
    fi
    if [[ -n "$@" ]]; then
        du $arg -- "$@";
    else
        du $arg .[^.]* ./*;
    fi;
}

if command -v git 1>/dev/null 2>&1; then
    function diff() {
        git diff --no-index --color-words "$@";
    }
fi;


# Compare original and gzipped file size
function gz() {
    local origsize='' gzipsize='' ratio=''
    origsize=$(wc -c < "$1");
    gzipsize=$(gzip -c "$1" | wc -c);
    ratio=$(echo "$gzipsize * 100 / $origsize" | bc -l);
    printf "orig: %d bytes\n" "$origsize";
    printf "gzip: %d bytes (%2.2f%%)\n" "$gzipsize" "$ratio";
}

# UTF-8-encode a string of Unicode symbols
function escape() {
    printf "\\\x%s" "$(printf "%s" "$@" | xxd -p -c1 -u);"
    # print a newline unless we’re piping the output to another program
    if [ -t 1 ]; then
        echo ""; # newline
    fi;
}

# Decode \x{ABCD}-style Unicode escape sequences
function unidecode() {
    # don't apply shellcheck to perl code
    # shellcheck disable=SC2145
    perl -e "binmode(STDOUT, ':utf8'); print \"$@\"";
    # print a newline unless we’re piping the output to another program
    if [ -t 1 ]; then
        echo ""; # newline
    fi;
}

# Get a character’s Unicode code point
function codepoint() {
    # don't apply shellcheck to perl code
    # shellcheck disable=SC2145
    perl -e "use utf8; print sprintf('U+%04X', ord(\"$@\"))";
    # print a newline unless we’re piping the output to another program
    if [ -t 1 ]; then
        echo ""; # newline
    fi;
}

# Show all the names (CNs and SANs) listed in the SSL certificate
# for a given domain
function getcertnames() {
    if [ -z "${1}" ]; then
        echo "ERROR: No domain specified.";
        return 1;
    fi;

    local domain="${1}";
    echo "Testing ${domain}…";
    echo ""; # newline

    local tmp=''
    tmp=$(echo -e "GET / HTTP/1.0\nEOT" \
              | openssl s_client -connect "${domain}:443" -servername "${domain}" 2>&1);

    if [[ "${tmp}" = *"-----BEGIN CERTIFICATE-----"* ]]; then
        local certText=''
        certText=$(echo "${tmp}" \
                       | openssl x509 -text -certopt "no_aux, no_header, no_issuer, no_pubkey, \
                        no_serial, no_sigdump, no_signame, no_validity, no_version");
        echo "Common Name:";
        echo ""; # newline
        echo "${certText}" | grep "Subject:" | sed -e "s/^.*CN=//" | sed -e "s/\/emailAddress=.*//";
        echo ""; # newline
        echo "Subject Alternative Name(s):";
        echo ""; # newline
        echo "${certText}" | grep -A 1 "Subject Alternative Name:" \
            | sed -e "2s/DNS://g" -e "s/ //g" | tr "," "\n" | tail -n +2;
        return 0;
    else
        echo "ERROR: Certificate not found.";
        return 1;
    fi;
}

# `o` with no arguments opens the current directory, otherwise opens the given
# location
# function o() {
#       if [ $# -eq 0 ]; then
#               open .;
#       else
#               open "$@";
#       fi;
# }

# `tre` is a shorthand for `tree` with hidden files and color enabled, ignoring
# the `.git` directory, listing directories first. The output gets piped into
# `less` with options to preserve color and line numbers, unless the output is
# small enough for one screen.
function tre() {
    tree -aC -I '.git|node_modules|bower_components' --dirsfirst "$@" | less -FRNX;
}

#
# jeffs functions
#
function jwm_host_p {
    dir=$HOME/pdata
    if [[ -e $dir && -d $dir ]]; then
        return 0;
    fi;
    return 1;
}


# is this a Mark43 laptop?
function mark43_host_p {
    dir=$HOME/code/dev43
    if [[ -e $dir && -d $dir ]]; then
        return 0;
    fi;
    return 1;
}

# join an array into a string
#  from https://stackoverflow.com/questions/1527049/join-elements-of-an-array
# join_by ' , ' a b c
#  gives
# a , b , c
function join_by { local d=$1; shift; echo -n "$1"; shift; printf "%s" "${@/#/$d}"; }

#
# sync Jeffs repos to ease multi machine editing.
#  shamelessly derived from http://doc.norang.ca/org-mode.html#git-sync
#

# Log a message for a repository
git_sync_log_msg() {
    printf "  %s\n" "$1"
}

git_sync_remote_ref() {
    local remote="$1"
    local ref="$2"

    printf "refs/remotes/%s/%s" "$remote" "$ref"
}

git_sync_ensure_remote_fetch() {
    local git_path="$1"
    local remote="$2"
    local fetch_refspec expected_refspec

    expected_refspec="+refs/heads/*:refs/remotes/${remote}/*"
    fetch_refspec=$(git -C "$git_path" config --get-all "remote.${remote}.fetch" 2>/dev/null)

    if [[ "$fetch_refspec" != *"$expected_refspec"* ]]; then
        git -C "$git_path" config --add "remote.${remote}.fetch" "$expected_refspec" || return 1
    fi
}

git_sync_resolve_branch_worktree() {
    local git_path="$1"
    local ref="$2"
    local worktree_path=""
    local branch_ref=""
    local line

    while IFS= read -r line
    do
        case "$line" in
            worktree\ *)
                worktree_path=${line#worktree }
                ;;
            branch\ refs/heads/*)
                branch_ref=${line#branch }
                if [[ "$branch_ref" == "refs/heads/$ref" ]]; then
                    printf "%s\n" "$worktree_path"
                    return 0
                fi
                ;;
            "")
                worktree_path=""
                branch_ref=""
                ;;
        esac
    done < <(git -C "$git_path" worktree list --porcelain)

    return 1
}

# fast-forward reference $ref to $remote/$ref
git_fast_forward_ref() {
    local git_path="$1"
    local remote="$2"
    local ref="$3"
    local remote_ref worktree_path

    remote_ref=$(git_sync_remote_ref "$remote" "$ref")
    git_sync_log_msg "fast-forwarding ref $ref"

    if worktree_path=$(git_sync_resolve_branch_worktree "$git_path" "$ref"); then
        git -C "$worktree_path" merge --ff-only "$remote_ref"
    else
        git -C "$git_path" update-ref "refs/heads/$ref" "$remote_ref"
    fi
}

# Push reference $1 to $remote
git_push_ref() {
    local git_path="$1"
    local remote="$2"
    local ref="$3"
    git_sync_log_msg "Pushing ref $ref to $remote"
    if ! git -C "$git_path" push --tags "$remote" "$ref"
    then
        return 1
    fi
}

# Check if a ref can be moved
#   - fast-forwards if behind the sync repo and is fast-forwardable
#   - Does nothing if ref is up to date
#   - Pushes ref to $remote if ref is ahead of remote and fastforwardable
#   - Fails if ref and $syncrop/ref have diverged
git_check_ref() {
    local git_path="$1"
    local remote="$2"
    local ref="$3"
    local remote_ref revlist1 revlist2

    remote_ref=$(git_sync_remote_ref "$remote" "$ref")
    revlist1=$(git -C "$git_path" rev-list "${remote_ref}..$ref")
    revlist2=$(git -C "$git_path" rev-list "$ref..${remote_ref}")
    if [ "x$revlist1" = "x" ] && [ "x$revlist2" = "x" ]
    then
        # Ref $ref is up to date.
        :
    elif [ "x$revlist1" = "x" ]
    then
        # Ref $ref is behind $remote/$ref and can be fast-forwarded.
        git_fast_forward_ref "$git_path" "$remote" "$ref" || return 1
    elif [ "x$revlist2" = "x" ]
    then
        # Ref $ref is ahead of $remote/$ref and can be pushed.
        git_push_ref "$git_path" "$remote" "$ref" || return 1
    else
        git_sync_log_msg "Ref $ref and $remote/$ref have diverged."
        return 1
    fi
}

# Check all local refs with matching refs in the $remote
#  effectively this syncs all tracking branchs
git_check_refs() {
    local git_path="$1"
    local remote="$2"
    local branch_ref ref

    while IFS= read -r branch_ref
    do
        ref=${branch_ref#refs/heads/}
        if git -C "$git_path" show-ref --verify --quiet "$(git_sync_remote_ref "$remote" "$ref")"; then
            git_check_ref "$git_path" "$remote" "$ref" || return 1
        fi
    done < <(git -C "$git_path" for-each-ref --format='%(refname)' "refs/heads/*")
}

git_check_ref_pull_only() {
    local git_path="$1"
    local remote="$2"
    local ref="$3"
    local remote_ref revlist1 revlist2

    remote_ref=$(git_sync_remote_ref "$remote" "$ref")
    revlist1=$(git -C "$git_path" rev-list "${remote_ref}..$ref") || return 1
    revlist2=$(git -C "$git_path" rev-list "$ref..${remote_ref}") || return 1
    if [ "x$revlist1" = "x" ] && [ "x$revlist2" = "x" ]
    then
        # Ref $ref is up to date.
        :
    elif [ "x$revlist1" = "x" ]
    then
        # Ref $ref is behind $remote/$ref and can be fast-forwarded.
        git_fast_forward_ref "$git_path" "$remote" "$ref" || return 1
    elif [ "x$revlist2" = "x" ]
    then
        git_sync_log_msg "Ref $ref is ahead of $remote/$ref; skipping push."
    else
        git_sync_log_msg "Ref $ref and $remote/$ref have diverged; skipping."
    fi
}

git_check_refs_pull_only() {
    local git_path="$1"
    local remote="$2"
    local branch_ref ref

    while IFS= read -r branch_ref
    do
        ref=${branch_ref#refs/heads/}
        if git -C "$git_path" show-ref --verify --quiet "$(git_sync_remote_ref "$remote" "$ref")"; then
            git_check_ref_pull_only "$git_path" "$remote" "$ref" || return 1
        fi
    done < <(git -C "$git_path" for-each-ref --format='%(refname)' "refs/heads/*")
}

# sync the remote down to local
git_update_remote() {
    local git_path="$1"
    local remote="$2"
    local upd_out

    if ! git_sync_ensure_remote_fetch "$git_path" "$remote"; then
        git_sync_log_msg "$git_path: FAILED to configure fetch refspec for $remote"
        return 1
    fi
    # Capture stdout+stderr so a failure (e.g. host unreachable when off VPN)
    # is logged rather than silently swallowed by the `|| return 1`.
    if ! upd_out=$(git -C "$git_path" remote update "$remote" 2>&1); then
        git_sync_log_msg "$git_path: FAILED remote update: $upd_out"
        return 1
    fi
    git_sync_log_msg "$git_path: $upd_out"
    [ "$upd_out" = "Fetching $remote" ] || {
        git_sync_log_msg "$git_path: $upd_out"
    }
}

git_sync() {
    local git_path="$1"
    local remote="$2"
    # A repo that isn't checked out on this machine (personal repos on the work
    # mac, and vice versa) is a skip, not a failure -- so gs_all only flags real
    # sync problems on repos that are actually present.
    if [[ ! -d $git_path ]]; then
        git_sync_log_msg "skipping $git_path: not present on this machine"
        return 0
    fi
    git_update_remote "$git_path" "$remote" || return 1
    git_check_refs "$git_path" "$remote" || return 1
}

git_sync_pull_only() {
    local git_path="$1"
    local remote="$2"
    if [[ ! -d $git_path ]]; then
        git_sync_log_msg "skipping $git_path: not present on this machine"
        return 0
    fi
    git_update_remote "$git_path" "$remote" || return 1
    git_check_refs_pull_only "$git_path" "$remote" || return 1
}

git_mark43_remote_p() {
    local remote_url="$1"

    case "$remote_url" in
        git@github.com:mark43/*|https://github.com/mark43/*|ssh://git@github.com/mark43/*)
            return 0
            ;;
        git@github.internal-mark43.us:*|https://github.internal-mark43.us/*|ssh://git@github.internal-mark43.us/*)
            return 0
            ;;
        git@github.internal-mark43-staging.us:*|https://github.internal-mark43-staging.us/*|ssh://git@github.internal-mark43-staging.us/*)
            return 0
            ;;
    esac

    return 1
}

# Of the mark43 remotes above, which reach their host only through the Zscaler
# Private Access tunnel? Those hosts resolve to ZPA synthetic IPs in
# 100.64.0.0/10 and stay unreachable until the day's Zscaler authentication has
# happened -- a step only Jeff can take. That is a precondition, not a race, so
# there is nothing a retry or a longer timeout can wait out; the sync has to
# recognize the state and skip rather than report a broken repo.
#
# Deliberately a separate predicate from git_mark43_remote_p rather than a flag
# on it: "is this ours?" and "can this be reached unattended?" are different
# questions, and only the second one governs whether a sync can run.
git_zpa_remote_p() {
    local remote_url="$1"

    case "$remote_url" in
        git@github.internal-mark43.us:*|https://github.internal-mark43.us/*|ssh://git@github.internal-mark43.us/*)
            return 0
            ;;
        git@github.internal-mark43-staging.us:*|https://github.internal-mark43-staging.us/*|ssh://git@github.internal-mark43-staging.us/*)
            return 0
            ;;
    esac

    return 1
}

# Host part of a git remote URL, for the reachability probe below. Handles the
# three forms the case arms above accept: scp-style, https, and ssh://.
git_remote_host() {
    local remote_url="$1"

    remote_url="${remote_url#ssh://}"
    remote_url="${remote_url#https://}"
    remote_url="${remote_url#http://}"
    remote_url="${remote_url#*@}"
    remote_url="${remote_url%%/*}"
    printf "%s\n" "${remote_url%%:*}"
}

# Can we get as far as SSH auth against this host?
#
# A TCP probe is not enough, and this is the whole trap: with the tunnel down,
# Zscaler still accepts the connection on its synthetic IP and only then hangs
# up -- `Connection closed by 100.64.1.28 port 22`. So `nc -z` reports success
# in exactly the broken state. The probe has to reach authentication.
#
# ssh reports its own transport and auth failures as 255, and otherwise passes
# through the remote command's status; GitHub Enterprise answers a good auth
# with the "does not provide shell access" banner and exits 1. So 255 is the
# signal, and anything else means we got far enough to be talking to git.
#
# An unknown host key also lands here as 255 and is treated as unreachable.
# That is the safe direction: skipping is recoverable, and StrictHostKeyChecking
# is not something a background job should be relaxing on its own.
#
# `-n` is load-bearing, not tidiness. The only caller runs this inside a
# `while IFS= read -r ... done < <(git_mark43_repo_paths)` loop, and ssh reads
# stdin by default -- so without it the probe swallows the rest of the repo
# list, and the loop silently stops at the first ZPA repo it meets. That failure
# is invisible in unit tests with a stubbed probe: it needs a real ssh to
# reproduce, and it looks like "some repos just did not sync" rather than an
# error.
git_ssh_host_reachable_p() {
    local host="$1"
    local rc

    ssh -n -o BatchMode=yes -o ConnectTimeout=5 -T "git@${host}" > /dev/null 2>&1
    rc=$?

    (( rc != 255 ))
}

git_repo_toplevel_p() {
    local git_path="$1"
    local repo_path toplevel_path

    repo_path=$(cd "$git_path" && pwd -P) || return 1
    toplevel_path=$(git -C "$git_path" rev-parse --show-toplevel 2>/dev/null) || return 1
    toplevel_path=$(cd "$toplevel_path" && pwd -P) || return 1

    [[ "$repo_path" == "$toplevel_path" ]]
}

git_mark43_repo_paths() {
    local code_dir="${HOME}/code"
    local git_path remote_url

    [[ -d "$code_dir" ]] || return 0

    for git_path in "$code_dir" "$code_dir"/*
    do
        [[ -d "$git_path" ]] || continue
        git_repo_toplevel_p "$git_path" || continue
        remote_url=$(git -C "$git_path" remote get-url origin 2>/dev/null) || continue
        if git_mark43_remote_p "$remote_url"; then
            printf "%s\n" "$git_path"
        fi
    done
}


# show history of recently checked out branches
gitbranches() {
    git reflog --date=relative | grep checkout \
        | sed -n -e 's/^.*{\(.*\)}.*to /\1|/p' \
        | perl -ane '$H{$F[2]}++ or print' | column -t -s'|' | head -n15
}


jwm_dir() {
    printf "%s\n" "${HOME}/jwm"
}

gs_todo() {
    git_sync "$(jwm_dir)/todo" origin
}

gs_notes() {
    git_sync "$(jwm_dir)/notes" origin
}

gs_dotfiles() {
    git_sync "$(jwm_dir)/proj/jwm-dotfiles-2024" origin
}

gs_jwm_bin() {
    git_sync "$(jwm_dir)/proj/jwm-bin" origin
}

gs_jwm_pdata_notes() {
    git_sync "${HOME}/pdata/notes" origin
}

gs_ebooks() {
    git_sync "$(jwm_dir)/ebooks" origin
}

gs_literate-emacs-d() {
    local status=0
    git_sync "$(jwm_dir)/proj/emacs-config" origin || status=1
    git_sync "$(jwm_dir)/proj/emacs-config/literate-emacs.d" origin || status=1
    return "$status"
}

gs_mark43_notes() {
    git_sync "${HOME}/mark43/notes" origin
}

# Sync every mark43 repo under ~/code, skipping the ZPA-only ones when the
# tunnel is not up.
#
# Exit status distinguishes the two outcomes, because they want different
# responses: 1 means a repo genuinely failed to sync and needs looking at, 2
# means only that some repos were skipped pending Zscaler authentication. A real
# failure wins if both happen -- it is the one that does not fix itself by
# starting the workday.
#
# Reachability is probed once per host and cached, so a down tunnel costs one
# 5-second timeout rather than one per repo.
gs_mark43_repos() {
    local git_path remote_url host status zpa_skipped
    local -A host_reachable=()

    status=0
    zpa_skipped=0
    while IFS= read -r git_path
    do
        remote_url=$(git -C "$git_path" remote get-url origin 2>/dev/null)

        if [[ -n "$remote_url" ]] && git_zpa_remote_p "$remote_url"; then
            host=$(git_remote_host "$remote_url")

            if [[ -n "$host" ]]; then
                if [[ -z ${host_reachable["$host"]+_} ]]; then
                    if git_ssh_host_reachable_p "$host"; then
                        host_reachable["$host"]=1
                    else
                        host_reachable["$host"]=0
                    fi
                fi

                if (( host_reachable["$host"] == 0 )); then
                    git_sync_log_msg "skipping $git_path: $host unreachable, Zscaler not authenticated yet"
                    zpa_skipped=1
                    continue
                fi
            fi
        fi

        git_sync_log_msg "Syncing $git_path"
        git_sync_pull_only "$git_path" origin || status=1
    done < <(git_mark43_repo_paths)

    if (( status )); then
        return 1
    fi
    if (( zpa_skipped )); then
        return 2
    fi
    return 0
}

gs_lab() {
    local status=0
    git_sync "$(jwm_dir)/proj/lab/lab-infra" origin || status=1
    git_sync "$(jwm_dir)/proj/lab/lab-gitops" origin || status=1
    return "$status"
}

gs_tome() {
    git_sync "$(jwm_dir)/proj/tome/tome" origin
}

# The repo groups below are split by which machine the repos live on, so that
# callers can run just the group they want. Each group appends the labels of any
# repos that failed to the global GS_FAILURES array and returns non-zero if any
# did; none of them reset it, so a caller running several groups accumulates one
# combined list. Reset GS_FAILURES=() before the first group -- gs_all and the
# `daily` launchd job both do.
#
# The groups deliberately do NOT test jwm_host_p / mark43_host_p themselves:
# the caller guards, which lets `daily` put other per-machine chores in the same
# block as the sync. Calling a group on the wrong machine is harmless anyway --
# git_sync skips a repo that isn't checked out.

# repos that live on every machine
gs_common() {
    local status=0
    gs_literate-emacs-d || { GS_FAILURES+=(literate-emacs-d); status=1; }
    gs_dotfiles         || { GS_FAILURES+=(dotfiles);         status=1; }
    gs_jwm_bin          || { GS_FAILURES+=(jwm_bin);          status=1; }
    return "$status"
}

# personal repos that live only on jeffs mac
gs_jwm_host() {
    local status=0
    gs_todo             || { GS_FAILURES+=(todo);             status=1; }
    gs_notes            || { GS_FAILURES+=(notes);            status=1; }
    gs_jwm_pdata_notes  || { GS_FAILURES+=(jwm_pdata_notes);  status=1; }
    gs_ebooks           || { GS_FAILURES+=(ebooks);           status=1; }
    gs_lab              || { GS_FAILURES+=(lab);              status=1; }
    gs_tome             || { GS_FAILURES+=(tome);             status=1; }
    return "$status"
}

# repos that live only on the mark43 laptop
gs_mark43_host() {
    local status=0
    local rc

    gs_mark43_notes || { GS_FAILURES+=(mark43_notes); status=1; }

    # gs_mark43_repos separates its two failure modes by exit status, so they
    # get separate labels: mark43_repos is a repo that needs attention,
    # mark43_repos-zpa is only "authenticate to Zscaler and it will catch up".
    # Both used to arrive as mark43_repos, which meant the notification could
    # not tell a corrupt packfile from a workday that had not started yet.
    gs_mark43_repos
    rc=$?
    case "$rc" in
        0) ;;
        2) GS_FAILURES+=(mark43_repos-zpa); status=1 ;;
        *) GS_FAILURES+=(mark43_repos);     status=1 ;;
    esac

    return "$status"
}

# Sync every repo that belongs on this machine. Runs all syncs even if some
# fail; records the labels of any that failed in the global GS_FAILURES array
# and returns non-zero if any did. Callers (interactive shell, the `daily`
# launchd job) can read GS_FAILURES to report which repos need attention.
gs_all() {
    local status=0
    GS_FAILURES=()

    # personal repos first that live only on jeffs mac
    if jwm_host_p; then
        gs_jwm_host || status=1
    fi;

    # common repos everywhere
    gs_common || status=1

    # then mark43 repos
    if mark43_host_p; then
        gs_mark43_host || status=1
    fi

    return "$status"
}

# git worktree functions

# show worktrees with their age
gwt-by-date() {
  git worktree list --porcelain | \
  awk '
    $1=="worktree" {path=$2}
    $1=="branch" {
      sub("refs/heads/","",$2)
      cmd="stat -f \"%SB\" -t \"%Y-%m-%d %H:%M\" " path
      cmd | getline ts
      close(cmd)
      print ts "|" path "|" $2
    }
  ' | sort | column -t -s '|'
}

# delete a worktree via three input forms:
#  1. raw git worktree list line
#  2. gwt-by-date output
#  3. accept a plain path
gwt-rm() {
  local input="$*"
  local path branch

  # Case 1: gwt-list format (starts with date)
  if [[ "$input" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2} ]]; then
    path=$(echo "$input" | awk '{print $3}')
    branch=$(echo "$input" | awk '{print $4}')

  # Case 2: git worktree list format ([branch] at end)
  elif [[ "$input" == *"["*"]"* ]]; then
    path=$(echo "$input" | awk '{print $1}')
    branch=$(echo "$input" | sed -n 's/.*\[\(.*\)\]/\1/p')

  # Case 3: assume raw path
  else
    path="$input"
    branch=$(basename "$path")
  fi

  if [[ -z "$path" || -z "$branch" ]]; then
    echo "❌ Unable to parse input"
    return 1
  fi

  echo "🧹 Removing worktree: $path"
  echo "🌿 Deleting branch:   $branch"

  git worktree remove "$path" 2>/dev/null || true
  git worktree prune --expire=now
  git branch -D "$branch"
}

# ----------------------------------------------------- shell-init cache -----
# Cache the output of `<tool> init bash`-style commands to a file and source
# that, instead of forking the tool on every login shell.
#
# This is the pattern jwm_refresh_completions already uses, extended from
# completions to shell init. bash-completion@2 gave completions a lazy loader
# for free; shell init has no such mechanism, so the sourcing side lives here
# too -- hence one table both halves read, rather than a list per half that can
# drift.
#
# Measured on this mac (mean of 5, `just profile-shell-startup` for context):
#   wt        21.8ms    starship  10.4ms    direnv  4.5ms    fzf     3.6ms
#   mise      11.0ms    zoxide     2.7ms
# ~54ms of a ~191ms interactive login shell, paid per terminal tab.
#
# The tradeoff is staleness: a tool upgrade can change its init script while the
# cached copy lingers. `jwm_refresh_shell_init` is wired into the `update` alias
# for the same reason jwm_refresh_completions is -- `brew upgrade` is the only
# place new versions arrive, and it runs immediately before.
JWM_SHELL_INIT_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/bash-shell-init"

# name -> the command whose stdout is the init script.
#
# starship is deliberately `--print-full-init` and not the documented
# `starship init bash`: the latter emits a 67-byte stub whose whole body is
# `eval -- "$(starship init bash --print-full-init)"`, so caching *it* would
# still fork starship on every shell. Asking for the full init directly caches
# the thing that actually matters. Cost of the pair was 6.0ms + 4.4ms.
#
# `command wt` is required, per the note in ~/.bash_profile: on a re-source the
# wt function already exists, and a bare `wt` would recurse into it.
#
# brewenv is single-quoted so `$(jwm_brew_cmd)` is stored literally and resolved
# when the script is generated -- jwm_brew_cmd stays the source of truth for
# which brew, so the Workbrew prefix on the Mark43 mac and the Homebrew one
# elsewhere each cache their own. Its output keeps the nested
# `eval "$(path_helper -s)"`, which is what makes the cached copy still react to
# the current PATH rather than freezing it.
declare -A JWM_SHELL_INIT_CMDS=(
    [starship]="starship init bash --print-full-init"
    [zoxide]="zoxide init bash"
    [direnv]="direnv hook bash"
    [fzf]="fzf --bash"
    [mise]="mise activate bash"
    [wt]="command wt config shell init bash"
    [brewenv]='"$(jwm_brew_cmd)" shellenv'
)

# How to tell whether a tool is present, for names where `command -v <name>` is
# not the answer. brewenv is an artifact name rather than a command, and brew's
# location is what jwm_brew_cmd exists to work out.
declare -A JWM_SHELL_INIT_PROBE=(
    [brewenv]="jwm_brew_cmd"
)

# Source the cached init for $1, generating it first if absent. Self-bootstraps,
# so a fresh machine costs exactly what the un-cached version cost -- one fork --
# and every later shell costs a source.
#
# Falls back to eval'ing the live command whenever the cache cannot be used, so
# an unwritable dir or a tool that fails mid-upgrade degrades to today's
# behaviour rather than to a broken shell. A short write is treated as failure
# and discarded: `-s` catches the empty file a crashed tool leaves behind.
jwm_shell_init() {
    local name="$1"
    local cmd="${JWM_SHELL_INIT_CMDS[$name]:-}"
    local f="${JWM_SHELL_INIT_DIR}/${name}"

    [[ -n "$cmd" ]] || return 0

    if [[ ! -s "$f" ]]; then
        if mkdir -p "${JWM_SHELL_INIT_DIR}" 2>/dev/null &&
               eval "$cmd" > "$f" 2>/dev/null && [[ -s "$f" ]]; then
            :
        else
            rm -f "$f" 2>/dev/null
            eval "$(eval "$cmd" 2>/dev/null)"
            return
        fi
    fi

    source "$f"
}

# Regenerate every cached init script. Call after a toolchain upgrade; `update`
# (jwm-bin) does, via jwm_update_tools.
#
# Two kinds of staleness, and the loop below only ever handled the first:
#
#   tool still in the table, binary gone   -> the rm -f before the probe covers it
#   tool removed from the table entirely   -> nothing referenced its file again
#
# The second left asdf's 4388-byte init sitting in the cache dir after #36 dropped
# it from JWM_SHELL_INIT_CMDS -- harmless, since nothing calls jwm_shell_init asdf
# any more, but the comment here used to promise it could not happen. Hence the
# prune, which is the same shape as the dangling-symlink reaping in
# jwm-bin#10/#34 and the version-dir prune the retired pyenv bridge carried: a
# refresh pass that only knows about what is still declared cannot clean up after
# a declaration being deleted.
jwm_refresh_shell_init() {
    local d="${JWM_SHELL_INIT_DIR}"
    local name=''
    local f=''

    mkdir -p "$d" || return 1

    for name in "${!JWM_SHELL_INIT_CMDS[@]}"; do
        rm -f "$d/$name"
        eval "${JWM_SHELL_INIT_PROBE[$name]:-command -v $name}" > /dev/null 2>&1 || continue
        if ! eval "${JWM_SHELL_INIT_CMDS[$name]}" > "$d/$name" 2>/dev/null ||
               [[ ! -s "$d/$name" ]]; then
            rm -f "$d/$name"
            printf 'jwm_refresh_shell_init: %s produced nothing; will fork at startup\n' \
                "$name" >&2
        fi
    done

    # Prune anything left that the table does not name. This directory is written
    # by nothing else, so a file that is not a key is a cache for a tool that used
    # to be one.
    #
    # Skipped when the table is empty rather than treated as "delete everything":
    # an empty JWM_SHELL_INIT_CMDS means a partial source or a broken declare,
    # which is a fault, not an instruction. The pyenv prune reasoned the same way
    # about an empty live set, for the same reason.
    #
    # Deliberately NOT extended to the completions dir, and no longer for the reason
    # #37 gave. That reason was jwm_refresh_completions' machine-local seam, which is
    # gone -- wiggum was the only tool using it and its line is tracked now.
    #
    # The reason that outlives the seam is whose directory each one is.
    # bash-shell-init is an invention of this repo: nothing else knows the name, so
    # a file there that the table does not name can only be our own leftover.
    # $BASH_COMPLETION_USER_DIR/completions is bash-completion@2's documented user
    # location, which any installer may legitimately write into. Pruning it would
    # mean deleting other software's files nightly on the assumption that this
    # function is the only writer, and that assumption is not ours to make.
    if (( ${#JWM_SHELL_INIT_CMDS[@]} > 0 )); then
        for f in "$d"/*; do
            [[ -f "$f" ]] || continue
            name="${f##*/}"
            [[ ${JWM_SHELL_INIT_CMDS[$name]+_} ]] && continue
            rm -f "$f" &&
                printf 'jwm_refresh_shell_init: pruned %s, no longer in the table\n' \
                    "$name" >&2
        done
    fi

    printf 'bash shell-init cache refreshed in %s\n' "$d"
}

# ---------------------------------------------------- completions cache -----
# bash-completion@2 lazily sources $BASH_COMPLETION_USER_DIR/completions/<cmd> on
# the first TAB for <cmd>, so these only need writing once -- not on every shell
# start. They are generated artifacts and stay out of git; this function is the
# tracked recipe.
#
# This lives here rather than in ~/.bash_profile, where it used to, because
# jwm_update_tools below calls it and `daily` sources only ~/.functions and
# ~/.path. Same reason jwm_cargo_path is in ~/.path and the uv system-certs
# setting is in ~/.config/uv/uv.toml: ~/.bash_profile is invisible to the
# launchd job.
#
# ORDERING INVARIANT: bash-completion v2 builds its lookup path at source time,
# so BASH_COMPLETION_USER_DIR must be exported before ~/.bash_profile sources
# bash_completion.sh. That holds because ~/.bash_profile sources ~/.functions in
# its first few lines, well above the completion block -- if that ever inverts,
# TAB stops finding these files.
export BASH_COMPLETION_USER_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/bash-completion";

jwm_refresh_completions() {
    local d="${BASH_COMPLETION_USER_DIR}/completions"
    mkdir -p "$d" || return 1

    # `rustup completions bash cargo` emits a shim that sources
    # "$(rustc --print sysroot)"/etc/bash_completion.d/cargo, resolving the
    # sysroot at source time -- so it survives `rustup update` and toolchain
    # switches, where a copied script would go stale.
    if command -v rustup > /dev/null; then
        rustup completions bash          > "$d/rustup"
        rustup completions bash cargo    > "$d/cargo"
    fi
    command -v rg   > /dev/null && rg --generate=complete-bash          > "$d/rg"
    command -v just > /dev/null && just --completions bash              > "$d/just"
    command -v uv   > /dev/null && uv generate-shell-completion bash    > "$d/uv"
    command -v ruff > /dev/null && ruff generate-shell-completion bash  > "$d/ruff"
    command -v mise > /dev/null && mise completion bash                 > "$d/mise"

    # `wiggum completion` is a 46-byte stub whose whole body is
    # `eval "$(_WIGGUM_COMPLETE=bash_source wiggum)"`, so caching *it* would still
    # fork wiggum at every completion. Asking for bash_source directly caches the
    # 671-byte function that actually matters -- the same distinction starship's
    # --print-full-init makes in JWM_SHELL_INIT_CMDS.
    command -v wiggum > /dev/null && _WIGGUM_COMPLETE=bash_source wiggum > "$d/wiggum"

    printf 'bash completions refreshed in %s\n' "$d"
}

# --------------------------------------------------------- update the tools -----
# The chore list shared by `daily` (unattended, under launchd) and `bin/update`
# (interactive) -- both in jwm-bin. It exists because those two had drifted:
# `daily` ran brew upgrade every morning and refreshed neither cache, so the
# shell-init and completion caches sat pointing at the previous versions' output
# until someone typed `update` by hand. #32 traded a fork-per-shell for a
# staleness window; this closes it.
#
# Everything here is safe unattended: no sudo, no prompt, no terminal needed.
# The steps that do need a terminal -- softwareupdate on jeffs mac, the
# quarantine strip on the Mark43 one -- live in bin/update instead. That split
# is the gate: it is why `daily` cannot walk into a sudo password prompt launchd
# has no way to answer, without needing a flag to say so.
#
# The order is a dependency chain, not taste:
#   brew update/upgrade   first -- everything below except rustup is a formula
#   uv python upgrade     uv is a brew formula, so it must follow brew upgrade
#   rustup update         before the refreshes, which shell out to rustup
#   refresh completions   invokes rustup, rg, just, uv, ruff, mise
#   refresh shell-init    invokes starship, zoxide, direnv, fzf, mise, wt, brew
#
# Failure labels go onto UPDATE_FAILURES, which the caller resets and reads --
# the same contract gs_* has with GS_FAILURES, so there is one pattern here
# rather than two. Returns 1 if anything failed, for callers that only want a
# yes/no.
jwm_update_tools() {
    local status=0

    brew update || { UPDATE_FAILURES+=(brew-update); status=1; }

    # The branch is about which brew, not whose machine, so it is if/else rather
    # than the two independent `if`s daily used to carry: a host that is neither
    # still gets a sane upgrade instead of silently getting none.
    if mark43_host_p; then
        # Workbrew machine: casks are disallowed by the workspace policy
        # (/opt/workbrew/var/workbrew.env.json), and a cask upgrade is also the
        # case most likely to want a prompt -- which launchd cannot answer. So
        # formulae only. NO_AUTO_UPDATE stops upgrade re-running the update we
        # just did.
        HOMEBREW_NO_AUTO_UPDATE=1 brew upgrade --formula \
            || { UPDATE_FAILURES+=(brew-upgrade); status=1; }
    else
        brew upgrade --no-ask || { UPDATE_FAILURES+=(brew-upgrade); status=1; }
    fi

    uv python upgrade || { UPDATE_FAILURES+=(uv-python); status=1; }
    rustup update     || { UPDATE_FAILURES+=(rustup);    status=1; }

    jwm_refresh_completions || { UPDATE_FAILURES+=(completions); status=1; }
    jwm_refresh_shell_init  || { UPDATE_FAILURES+=(shell-init);  status=1; }

    return "$status"
}

#
# end jeffs functions
#
